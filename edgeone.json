{
  "name": "excalidraw-storage-backend-cloudflare",
  "buildCommand": "",
  "installCommand": "npm install",
  "outputDirectory": "./public",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    }
  ]
}
